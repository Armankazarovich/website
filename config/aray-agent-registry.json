{
  "version": "2026-05-01",
  "name": "ARAY Agent Mesh Registry",
  "principle": "No dark corners: every product area must have an owner department, owner agent, reviewer agent, quality score, risk status, audit trail and next action.",
  "riskStatuses": ["green", "yellow", "red", "blocked"],
  "qualityDimensions": [
    "meaning",
    "business_value",
    "working_logic",
    "ux_clarity",
    "design_system",
    "responsive",
    "pwa_touch",
    "performance",
    "security_roles",
    "notifications",
    "seo_growth",
    "accessibility",
    "data_integrity",
    "production_stability"
  ],
  "autonomyLevels": [
    { "level": 0, "name": "sensor", "meaning": "Only measures and reports." },
    { "level": 1, "name": "advisor", "meaning": "Prepares recommendations, drafts and tasks." },
    { "level": 2, "name": "safe_autofix", "meaning": "May fix safe, reversible issues in its zone." },
    { "level": 3, "name": "controlled_action", "meaning": "May prepare commits, reports or controlled actions through quality gates." },
    { "level": 4, "name": "approved_automation", "meaning": "Allowed only for proven workflows with logs and limits." }
  ],
  "globalEscalationRules": [
    "money_or_payments",
    "personal_data",
    "role_or_permission_change",
    "mass_notification_or_campaign",
    "production_database_change",
    "data_deletion",
    "legal_or_tax_risk",
    "secret_or_key_exposure",
    "tenant_isolation_risk"
  ],
  "departments": [
