// ═══════════════════════════════════════════════════════════════════════════
// MULTI-TENANCY (Stage 1 подготовка — схема готова, Row-Level Security в Stage 3)
// ═══════════════════════════════════════════════════════════════════════════
// Главная таблица тенантов. Один тенант = один магазин-поставщик.
// tenantId "pilorus" — дефолтный (сам ПилоРус).
// Колонка tenantId добавлена ко всем core моделям с @default("pilorus"),
// @@index([tenantId]) — для быстрой фильтрации.
// Пока данные НЕ разделяются (в Этапе 3 добавим middleware фильтр + RLS).
model ArayModuleState {
  id               String   @id @default(cuid())
  tenantId         String   @default("pilorus")
  moduleId         String
  enabled          Boolean  @default(true)
  locked           Boolean  @default(false)
  rolePolicy       Json     @default("{}")
  subscriptionPlan String?
  connectorPolicy  Json     @default("{}")
  reason           String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, moduleId])
  @@index([tenantId, enabled])
  @@index([moduleId])
  @@index([updatedById])
}

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique           // "pilorus", "severniy-les"
  name        String                     // "ПилоРус", "Северный Лес"
  domain      String?  @unique           // "pilo-rus.ru" (custom domain, опционально)
  logoUrl     String?
  primaryColor String?                   // HSL для темы: "35 60% 45%"
  plan        String   @default("free")  // "free", "pro", "enterprise"
  active      Boolean  @default(true)
  settings    Json     @default("{}")    // доп. настройки тенанта
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

