generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  tenantId        String         @default("pilorus")
  name           String?
  email          String             @unique
  phone          String?
  phoneVisibility String       @default("contacts")
  arayPhoneVisibility String   @default("contacts")
  passwordHash   String
  role           Role               @default(USER)
  address        String?
  avatarUrl      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  customRole     String?
  staffStatus    StaffStatus?
  lastActiveAt   DateTime?
  arayMemory     ArayMemory?
  arayMessages   ArayMessage[]
  assignedLeads  Lead[]             @relation("LeadAssignee")
  leadActivities LeadActivity[]     @relation("LeadActivityUser")
  orders         Order[]
  pushSubs       PushSubscription[]
  reviews        Review[]
  supportIncidents SupportIncident[]
  assignedTasks  Task[]             @relation("TaskAssignee")
  createdTasks   Task[]             @relation("TaskCreator")
  taskComments   TaskComment[]
  businessRoleMembers BusinessRoleMember[]

  @@index([tenantId])

  @@index([role, staffStatus])
  @@index([lastActiveAt])
  @@index([phone])
}

model Category {
  id             String     @id @default(cuid())
  tenantId        String         @default("pilorus")
  name           String
  slug           String
  image          String?
  sortOrder      Int        @default(0)
  parentId       String?
  seoDescription String?
  seoTitle       String?
  showInFooter   Boolean    @default(true)
  showInMenu     Boolean    @default(true)
  updatedAt      DateTime   @default(now()) @updatedAt
  parent         Category?  @relation("sub", fields: [parentId], references: [id])
  children       Category[] @relation("sub")
  products       Product[]

  @@index([tenantId])
  @@unique([tenantId, slug])
}

model Product {
  id          String           @id @default(cuid())
  tenantId        String         @default("pilorus")
  slug        String
  name        String
  shortDescription String?
  description String?
  categoryId  String
  images      String[]
  cardTags    String[]         @default([])
  saleUnit    SaleUnit         @default(BOTH)
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     Review[]

  @@index([tenantId])

  @@index([categoryId])
  @@index([active])
  @@index([featured])
  @@index([active, featured])
  @@index([name])
  @@unique([tenantId, slug])
}

model ProductVariant {
  id                 String      @id @default(cuid())
  productId          String
  size               String
  pricePerCube       Decimal?    @db.Decimal(10, 2)
  pricePerPiece      Decimal?    @db.Decimal(10, 2)
  piecesPerCube      Int?
  inStock            Boolean     @default(true)
  stockQty           Int?
  lowStockThreshold  Int         @default(0)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
  costPrice          CostPrice?
  orderItems         OrderItem[]
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

model Order {
  id                String      @id @default(cuid())
  tenantId        String         @default("pilorus")
  orderNumber       Int         @default(autoincrement())
  userId            String?
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  status            OrderStatus @default(NEW)
  totalAmount       Decimal     @db.Decimal(10, 2)
  paymentMethod     String      @default("Наличные / Счёт")
  deliveryAddress   String?
  comment           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deliveryCost      Decimal     @default(0) @db.Decimal(10, 2)
  deletedAt         DateTime?
  telegramMessageId String?
  contactMethod     String?
  contactUsername   String?
  terminalProfile   String?
  terminalWorkMode  String?
  fulfillmentType   String?
  fulfillmentDetail String?
  receiptMode       String?
  paymentStatus     String      @default("PENDING")
  fiscalStatus      String      @default("PENDING")
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  promoCode         String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmTerm           String?
  utmContent        String?
  gclid             String?
  yclid             String?
  referrer          String?
  landingPage       String?
  firstTouchAt      DateTime?
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]
  tasks             Task[]

  @@index([tenantId])

  @@index([userId, createdAt])
  @@index([status, deletedAt])
  @@index([createdAt])
  @@index([guestPhone])
  @@index([telegramMessageId])
  @@index([paymentStatus, createdAt])
  @@index([fiscalStatus, createdAt])
  @@index([utmSource, createdAt])
  @@index([utmCampaign, createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  variantId   String
  productName String
  variantSize String
  unitType    UnitType
  quantity    Decimal        @db.Decimal(10, 3)
  price       Decimal        @db.Decimal(10, 2)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productName])
}

model Review {
  id           String    @id @default(cuid())
  tenantId        String         @default("pilorus")
  userId       String?
  productId    String?
  name         String
  rating       Int
  text         String
  images       String[]  @default([])
  approved     Boolean   @default(false)
  likes        Int       @default(0)
  dislikes     Int       @default(0)
  adminReply   String?
  adminReplyAt DateTime?
  createdAt    DateTime  @default(now())
  externalId   String?
  source       String    @default("internal")
  sourceUrl    String?
  user         User?     @relation(fields: [userId], references: [id])
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])

  @@index([approved, createdAt(sort: Desc)])
  @@index([productId])
  @@index([userId, createdAt(sort: Desc)])
}

model Promotion {
  id          String    @id @default(cuid())
  tenantId        String         @default("pilorus")
  title       String
  description String
  discount    Int?
  imageUrl    String?
  validUntil  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model DeliveryRate {
  id          String @id @default(cuid())
  tenantId        String         @default("pilorus")
  vehicleName String
  payload     String
  maxVolume   Float
  basePrice   Int
  sortOrder   Int    @default(0)

  @@index([tenantId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model NotificationCenterEvent {
  id              String                     @id @default(cuid())
  tenantId        String                     @default("pilorus")
  direction       NotificationDirection      @default(OUTBOUND)
  channel         NotificationChannel        @default(PUSH)
  status          NotificationStatus         @default(QUEUED)
  source          NotificationSource         @default(ADMIN)
  sourceUserId    String?
  title           String
  body            String                     @db.Text
  url             String?
  segment         String?
  recipientUserId String?
  recipientLabel  String?
  recipientRole   String?
  sentCount       Int                        @default(0)
  failedCount     Int                        @default(0)
  cleanedCount    Int                        @default(0)
  error           String?                    @db.Text
  entityType      TaskRelationEntityType?
  entityId        String?
  entityLabel     String?
  entityHref      String?
  metadata        Json                       @default("{}")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  sentAt          DateTime?
  readAt          DateTime?
  archivedAt      DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, channel, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([recipientUserId, createdAt])
}

model NotificationRolePreference {
  id                String   @id @default(cuid())
  tenantId          String   @default("pilorus")
  role              Role
  eventKey          String
  enabled           Boolean  @default(true)
  channels          Json     @default("[]")
  quietHoursEnabled Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, role, eventKey])
  @@index([tenantId, role])
  @@index([eventKey])
}

model NotificationRoleSchedule {
  id                String   @id @default(cuid())
  tenantId          String   @default("pilorus")
  role              Role
  quietHoursEnabled Boolean  @default(false)
  quietStart        String   @default("21:00")
  quietEnd          String   @default("09:00")
  weekendsMuted     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, role])
  @@index([tenantId])
}

model BusinessRole {
  id               String   @id @default(cuid())
  tenantId         String   @default("pilorus")
  roleKey          String
  label            String
  description      String?
  baseRole         Role?
  scope            String   @default("business")
  roleKind         String   @default("custom")
  permissions      Json     @default("{}")
  notificationSeed Json     @default("{}")
  isSystem         Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  members          BusinessRoleMember[]
  notificationPreferences NotificationAudiencePreference[]

  @@unique([tenantId, roleKey])
  @@index([tenantId, isActive])
  @@index([tenantId, baseRole])
  @@index([tenantId, scope])
}

model BusinessRoleMember {
  id             String       @id @default(cuid())
  tenantId       String       @default("pilorus")
  businessRoleId String
  userId         String
  status         StaffStatus?
  isPrimary      Boolean      @default(false)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  role           BusinessRole @relation(fields: [businessRoleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessRoleId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, userId, isPrimary])
  @@index([tenantId, businessRoleId])
}

model NotificationAudiencePreference {
  id                String        @id @default(cuid())
  tenantId          String        @default("pilorus")
  audienceKey       String
  audienceLabel     String?
  businessRoleId    String?
  eventKey          String
  enabled           Boolean       @default(true)
  channels          Json          @default("[]")
  quietHoursEnabled Boolean       @default(false)
  quietStart        String        @default("21:00")
  quietEnd          String        @default("09:00")
  weekendsMuted     Boolean       @default(false)
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  businessRole      BusinessRole? @relation(fields: [businessRoleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, audienceKey, eventKey])
  @@index([tenantId, audienceKey])
  @@index([tenantId, eventKey])
  @@index([businessRoleId])
}

model SiteSettings {
  id    String @id @default(cuid())
  tenantId        String         @default("pilorus")
  key   String
  value String

  @@index([tenantId])
  @@unique([tenantId, key])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  tenantId        String         @default("pilorus")
  email        String   @unique
  name         String?
  pushEnabled  Boolean  @default(false)
  telegramChat String?
  source       String   @default("site")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model PromoCode {
  id          String    @id @default(cuid())
  tenantId        String         @default("pilorus")
  code        String    @unique
  type        String
  value       Int
  minAmount   Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  description String?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model PartnershipLead {
  id        String   @id @default(cuid())
  tenantId        String         @default("pilorus")
  name      String
  company   String?
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CategoryRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  toSlug    String?
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  tenantId        String         @default("pilorus")
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model CostPrice {
  id           String         @id @default(cuid())
  variantId    String         @unique
  costPerCube  Decimal?       @db.Decimal(10, 2)
  costPerPiece Decimal?       @db.Decimal(10, 2)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Task {
  id          String        @id @default(cuid())
  tenantId        String         @default("pilorus")
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  sortOrder   Int           @default(0)
  assigneeId  String?
  createdById String?
  orderId     String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tags        String[]      @default([])
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User?         @relation("TaskCreator", fields: [createdById], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
  comments    TaskComment[]
  relations   TaskRelation[]

  @@index([tenantId])
}

model TaskRelation {
  id         String                 @id @default(cuid())
  tenantId   String                 @default("pilorus")
  taskId     String
  entityType TaskRelationEntityType
  entityId   String
  label      String?
  href       String?
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now())
  task       Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  text      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Lead {
  id               String         @id @default(cuid())
  tenantId        String         @default("pilorus")
  name             String
  phone            String?
  email            String?
  company          String?
  source           LeadSource     @default(WEBSITE)
  stage            LeadStage      @default(NEW)
  value            Decimal?       @db.Decimal(10, 2)
  currency         String         @default("RUB")
  comment          String?
  tags             String[]       @default([])
  assigneeId       String?
  convertedOrderId String?
  convertedAt      DateTime?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  assignee         User?          @relation("LeadAssignee", fields: [assigneeId], references: [id])
  activities       LeadActivity[]

  @@index([tenantId])

  @@index([assigneeId, stage])
  @@index([stage])
  @@index([createdAt])
}

model LeadActivity {
  id           String           @id @default(cuid())
  leadId       String
  type         LeadActivityType @default(NOTE)
  text         String
  scheduledFor DateTime?
  completedAt  DateTime?
  userId       String?
  createdAt    DateTime         @default(now())
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?            @relation("LeadActivityUser", fields: [userId], references: [id])

  @@index([leadId])
}

model Workflow {
  id          String        @id @default(cuid())
  tenantId        String         @default("pilorus")
  name        String
  description String?
  active      Boolean       @default(true)
  trigger     String
  conditions  Json          @default("{}")
  actions     Json          @default("[]")
  delayMinutes Int?                        // задержка перед выполнением (в минутах)
  category    String        @default("robot") // "robot" | "tunnel" | "report"
  nicheTag    String?                      // привязка к шаблону ниши
  sortOrder   Int           @default(0)
  executionCount Int        @default(0)    // сколько раз сработал
  lastExecutedAt DateTime?                 // когда последний раз
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  logs        WorkflowLog[]

  @@index([tenantId])
}

model WorkflowLog {
  id         String   @id @default(cuid())
  workflowId String
  trigger    String
  payload    Json     @default("{}")
  result     String
  error      String?
  createdAt  DateTime @default(now())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model ArayMemory {
  id           String    @id @default(cuid())
  userId       String?   @unique
  sessionId    String?   @unique
  facts        Json      @default("{}")
  summary      String    @default("")
  lastMessages Json      @default("[]")
  level        ArayLevel @default(NOVICE)
  totalChats   Int       @default(0)
  totalPoints  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(cuid())
  tenantId        String         @default("pilorus")
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  aiGenerated Boolean  @default(false)
  topic       String?
  readTime    Int      @default(5)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])

  @@index([published, createdAt(sort: Desc)])
  @@index([published, featured])
}

model StoreStory {
  id          String         @id @default(cuid())
  tenantId    String         @default("pilorus")
  type        StoreStoryType @default(IMAGE)
  title       String
  subtitle    String?
  description String?
  mediaUrl    String?
  posterUrl   String?
  ctaLabel    String?
  ctaUrl      String?
  entityType  String?
  entityId    String?
  placement   String         @default("site")
  active      Boolean        @default(true)
  pinned      Boolean        @default(false)
  sortOrder   Int            @default(100)
  views       Int            @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  relations   StoreStoryRelation[]

  @@index([tenantId])
  @@index([active, pinned, sortOrder])
  @@index([entityType, entityId])
}

model StoreStoryRelation {
  id         String     @id @default(cuid())
  tenantId   String     @default("pilorus")
  storyId    String
  entityType String
  entityId   String
  label      String?
  image      String?
  ctaUrl     String?
  sortOrder  Int        @default(100)
  createdAt  DateTime   @default(now())
  story      StoreStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@index([storyId, sortOrder])
}

model Service {
  id          String   @id @default(cuid())
  tenantId        String         @default("pilorus")
  slug        String   @unique
  title       String
  description String
  content     String
  price       String?
  unit        String?
  image       String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // VIEW_PRODUCT, PLACE_ORDER, WRITE_REVIEW, LOGIN, PAGE_VISIT
  targetId  String?  // productId, orderId, etc.
  meta      Json?    // extra data (product name, page url, etc.)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model SupportIncident {
  id          String   @id @default(cuid())
  tenantId    String   @default("pilorus")
  code        String   @unique
  title       String
  category    String   @default("terminal")
  severity    String   @default("medium")
  status      String   @default("OPEN")
  source      String   @default("aray")
  page        String?
  orderId     String?
  device      String?
  message     String   @db.Text
  diagnostics Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([category, severity])
  @@index([orderId])
}

model TerminalWorkstation {
  id          String   @id @default(cuid())
  tenantId    String   @default("pilorus")
  name        String
  type        String   @default("MOBILE")
  profile     String   @default("lumber")
  status      String   @default("ACTIVE")
  deviceLabel String?
  printerMode String?
  scannerMode String?
  paymentMode String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shifts      CashShift[]
  printJobs   PrintJob[]

  @@index([tenantId, status])
  @@index([profile, type])
}

model CashShift {
  id             String   @id @default(cuid())
  tenantId       String   @default("pilorus")
  workstationId  String?
  openedById     String?
  closedById     String?
  status         String   @default("OPEN")
  openingCash    Decimal  @default(0) @db.Decimal(10, 2)
  expectedCash   Decimal  @default(0) @db.Decimal(10, 2)
  actualCash     Decimal? @db.Decimal(10, 2)
  cashDelta      Decimal? @db.Decimal(10, 2)
  cardTotal      Decimal  @default(0) @db.Decimal(10, 2)
  onlineTotal    Decimal  @default(0) @db.Decimal(10, 2)
  salesTotal     Decimal  @default(0) @db.Decimal(10, 2)
  refundTotal    Decimal  @default(0) @db.Decimal(10, 2)
  orderCount     Int      @default(0)
  notes          String?
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workstation    TerminalWorkstation? @relation(fields: [workstationId], references: [id])
  operations     ShiftOperation[]

  @@index([tenantId, status, openedAt])
  @@index([workstationId, status])
  @@index([openedById, status])
}

model ShiftOperation {
  id        String   @id @default(cuid())
  tenantId  String   @default("pilorus")
  shiftId   String
  type      String
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  orderId   String?
  actorId   String?
  note      String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  shift     CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, createdAt])
  @@index([type, createdAt])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String   @default("pilorus")
  orderId     String?
  shiftId     String?
  method      String
